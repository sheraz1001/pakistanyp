# Copy to .env for local development. Placeholders only: real values live in Hostinger's environment settings.

# Database (Neon: use the POOLED connection string, host contains "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# DATABASE_DRIVER=pg            # local Postgres instead of the Neon driver
SESSION_SECRET=change-me

# Site
# SITE_ORIGIN=https://example.com
# CANONICAL_HOST=example.com

# Database usage / egress controls
# DB_METRICS_LOG=1              # log top DB routes by bytes every hour
# DB_METRICS_OPEN=0             # 1 = /api/metrics/db readable without admin login (debug only)
# FORCE_STARTUP_SYNC=0          # 1 = re-run catalog/content sync on start even if the build did not change
# INDEXNOW_INTERVAL_MINUTES=180

# Bot protection (comma-separated user-agent fragments; replace the default lists)
# BLOCKED_BOTS=GPTBot,CCBot,Bytespider,AhrefsBot,SemrushBot,MJ12bot,DotBot,PetalBot
# ALLOWED_BOTS=

# Optional services
# SENDGRID_API_KEY=
# OPENAI_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
